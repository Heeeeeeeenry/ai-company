# ── 绝对不能进镜像 ────────────────────────────────────────────────────
.git
.gitignore
.env
.env.*
!.env.example

# ── 本地/测试产物 ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.dbg/
*.log
qa_reports/
data/
memory/

# ── 与运行无关的文档/素材 ─────────────────────────────────────────────
docs/
*.png
*.jpg
*.jpeg
*.gif
*.mp4

# ── 接入件与部署脚本由宿主机（Django）使用，镜像内用不到 ──────────────
integration/
scripts/
