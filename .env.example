# ─────────────────────────────────────────────────────────────────────
# ai-company (狗蛋儿) 环境变量样例
#
#   cp .env.example .env  然后按注释填值；.env 已在 .gitignore 里，不要提交。
#
# 本文件同时是"嵌入民意智感中心管理端"的服务端配置模板。
# 关键点：ai-company 用**自己的一套** DeepSeek 配置，不复用宿主机/别的
# 进程的环境变量——所以下面所有 key 都优先读 AI_COMPANY_* 前缀。
# ─────────────────────────────────────────────────────────────────────

# ── 1. 模型：用哪家的 DeepSeek ────────────────────────────────────────
# provider 只有两个取值：
#   oneapi   = 走内网 OneAPI 代理（默认，模型名用 DeepSeek-V4-Flash 这类）
#   deepseek = 走 DeepSeek 官方端点（模型名用 deepseek-chat / deepseek-reasoner）
AI_COMPANY_MODEL_PROVIDER=oneapi
AI_COMPANY_MODEL_BASE_URL=https://oneapi-comate.baidu-int.com/v1
AI_COMPANY_MODEL=DeepSeek-V4-Flash

# 想一次性切到官方 DeepSeek，就这三行二选一：
#   AI_COMPANY_MODEL_PROVIDER=deepseek
#   AI_COMPANY_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#   AI_COMPANY_DEEPSEEK_MODEL=deepseek-chat
# （留空 base_url 时 provider=deepseek 自动用官方 https://api.deepseek.com/v1）

# ── 2. 凭证：按端点分开，绝不串用 ────────────────────────────────────
# 走内网 OneAPI 用这个：
AI_COMPANY_ONEAPI_API_KEY=
# 走官方 DeepSeek 用这个（ai-company 自己的 key，和 OneAPI 的 key 不是一回事）：
AI_COMPANY_DEEPSEEK_API_KEY=
# 兼容旧变量名（没有 AI_COMPANY_* 时会回落，二选一即可）：
# DEEPSEEK_API_KEY=
# ONEAPI_API_KEY=

# ── 3. 角色级模型覆盖（不填就用默认模型）─────────────────────────────
# 各角色可单独指定，例如让 CEO 用便宜快的、developer 用强的：
CEO_MODEL=DeepSeek-V4-Flash
PM_MODEL=DeepSeek-V4-Flash
ARCHITECT_MODEL=DeepSeek-V4-Flash
DEVELOPER_MODEL=DeepSeek-V4-Flash
QA_MODEL=DeepSeek-V4-Flash
DEVOPS_MODEL=DeepSeek-V4-Flash
RESEARCH_MODEL=DeepSeek-V4-Flash
MARKETER_MODEL=DeepSeek-V4-Flash
REVIEW_MODEL=DeepSeek-V4-Flash

# ── 4. 多用户服务（嵌入管理端时必开）─────────────────────────────────
# goudan-api 启动器会强制设为 1；这里列出来是为了让 .env 自解释：
#   1 = 服务模式：不读宿主机的 CLI 会话、会话记忆落在独立根目录、
#       请求级会话作用域生效。任何对外提供服务的部署都必须为 1。
AI_COMPANY_SERVICE_MODE=1
# 服务端口（管理端 nginx 反代到这里）：
AI_COMPANY_API_HOST=127.0.0.1
AI_COMPANY_API_PORT=8020
# 服务端会话记忆根目录（务必与 ~/.ai-company/sessions 分开）：
# AI_COMPANY_SERVICE_SESSION_DIR=~/.ai-company/service_sessions
# 多用户库（会话/消息/归属）路径：
# AI_COMPANY_MULTIUSER_DB=~/.ai-company/multiuser.db
# 运行时模型配置覆盖文件：
# AI_COMPANY_MODEL_CONFIG=~/.ai-company/model_config.json

# ── 5. 视觉（读图用；DeepSeek 不支持视觉，走 Qwen-VL）───────────────
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen-vl-max

# ── 6. 兜底 / 其它 ──────────────────────────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# TAVILY_API_KEY=
LOG_LEVEL=INFO
