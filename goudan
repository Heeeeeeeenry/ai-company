#!/usr/bin/env bash
# ─── 狗蛋儿 · AI Company Launcher ───
# Cross-platform: macOS, Linux, WSL
#
# Usage:
#   goudan              # Interactive CLI
#   goudan "write fib"  # One-shot query
#   goudan --telegram   # Start Telegram bot
#
# Shared env resolution lives in scripts/env.sh (project + absolute Python path).

set -e

# ─── Resolve project + Python (shared with goudan-api) ────────────────
# 先解析出本脚本的**真实**路径（跟随软链）。BASH_SOURCE[0] 在通过软链调用时
# 就是软链自身（bash 不会自动规范化），若直接对它取 dirname，在
# ~/.local/bin/goudan -> <repo>/goudan 这种场景下会去找
# ~/.local/bin/scripts/env.sh 而报 "No such file or directory"。
_SELF="${BASH_SOURCE[0]}"
while [ -L "$_SELF" ]; do
    _LINK="$(readlink "$_SELF")"
    case "$_LINK" in
        /*) _SELF="$_LINK" ;;
        *)  _SELF="$(cd "$(dirname "$_SELF")" && pwd -P)/$_LINK" ;;
    esac
done
_SCRIPT_DIR="$(cd "$(dirname "$_SELF")" && pwd -P)"
# shellcheck source=scripts/env.sh
. "$_SCRIPT_DIR/scripts/env.sh"
resolve_python

# ─── Run ───────────────────────────────────────────────────────────────
cd "$AI_COMPANY_DIR"

# ─── 参数适配 ─────────────────────────────────────────────────────────
# src.main 的 argparse 只接受 --query / --mode {telegram,cli} 等**具名**标志，
# 不接受位置参数（直接 `goudan "文本"` 会报 "unrecognized arguments"）。
# 这里把本脚本文档化的简写翻成真实接口，避免踩坑：
#   goudan                  → --mode cli
#   goudan "文本"           → --query "文本"
#   goudan --telegram       → --mode telegram
#   goudan <其它标志...>    → 原样透传
if [ $# -eq 0 ]; then
    set -- --mode cli
else
    case "$1" in
        --telegram) set -- --mode telegram "${@:2}" ;;
        -*)         : ;;                          # 已是合法标志，原样透传
        *)          set -- --query "$1" "${@:2}" ;;
    esac
fi

exec "$PYTHON" -m src.main "$@"
