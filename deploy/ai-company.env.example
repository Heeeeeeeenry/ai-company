# ─────────────────────────────────────────────────────────────────────
# ai-company 容器环境变量 —— 复制为 ai-company.env 后填值
#
#   cp ai-company.env.example ai-company.env && vi ai-company.env
#
# ⚠️ ai-company.env 含密钥，不要提交到 git、不要 cp 进镜像。
# ─────────────────────────────────────────────────────────────────────

# ── 服务模式（容器里必须开）────────────────────────────────────────
# 注意：这里设 1 是安全的，因为容器内没有本地 CLI；
# 本机开发时这个变量绝不能出现在 .env 里（会把 goudan 也拖进服务模式）。
AI_COMPANY_SERVICE_MODE=1
AI_COMPANY_API_HOST=0.0.0.0
AI_COMPANY_API_PORT=8020

# ── 模型：走 DeepSeek 官方端点 ──────────────────────────────────────
# 该机能出网到 api.deepseek.com（已实测），但**到不了百度内网 OneAPI**，
# 所以只能走官方端点。
AI_COMPANY_MODEL_PROVIDER=deepseek
AI_COMPANY_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_COMPANY_DEEPSEEK_MODEL=deepseek-v4-flash

# 与 dev_admin 的 .env 里 LLM_API_KEY 是同一把 key（公网 DeepSeek）。
# 运行时注入，不进镜像、不进 git。
AI_COMPANY_DEEPSEEK_API_KEY=

# ── 角色级模型覆盖 ─────────────────────────────────────────────────
# 不设的话会回落到 config.py 里 gpt-5.5 的默认值（在本环境不可用）。
# 统一压到 deepseek-v4-flash，保证不管走哪个角色都不会打到不存在的模型。
CEO_MODEL=deepseek-v4-flash
PM_MODEL=deepseek-v4-flash
ARCHITECT_MODEL=deepseek-v4-flash
DEVELOPER_MODEL=deepseek-v4-flash
QA_MODEL=deepseek-v4-flash
DEVOPS_MODEL=deepseek-v4-flash
RESEARCH_MODEL=deepseek-v4-flash
MARKETER_MODEL=deepseek-v4-flash
REVIEW_MODEL=deepseek-v4-flash

# ── AI 受控取数工具层（容器 -> 宿主 dev_admin）───────────────────────
# 容器没有任何数据库连接：业务数据一律通过宿主 /ai-internal/tools/ 取，宿主
# 内部再走它自己的 service 层与权限中心，所以「AI 看到什么」= 「这个登录用户
# 在界面上能看到什么」。
# 这两个值由 deploy/dev_admin/patch_dev_admin.py 安装时自动写入（并保证与宿主
# settings.py 的 AI_COMPANY_INTERNAL_TOKEN 一致），一般不用手填。
#   容器里的 127.0.0.1 是容器自己 -> 必须走 docker 网关（compose 有 extra_hosts）
AI_COMPANY_HOST_BASE_URL=http://host.docker.internal:15173
# 与服务端 AI_COMPANY_INTERNAL_TOKEN 必须一致；留空 = 通道关闭（AI 只做普通对话）
AI_COMPANY_HOST_INTERNAL_TOKEN=
# 单次工具调用超时（秒）
AI_COMPANY_HOST_TOOLS_TIMEOUT=30

# ── 其它 ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# 视觉模型（可选）：DeepSeek 不支持看图，需要读图时填 Qwen-VL。
# QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen-vl-max
